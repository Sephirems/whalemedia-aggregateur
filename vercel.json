{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node",
      "config": { "includeFiles": "src/**" }
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/([^/.]+)",
      "dest": "/api/$1.js",
      "headers": { "X-Robots-Tag": "noindex, nofollow" }
    },
    { "handle": "filesystem" },
    {
      "src": "/",
      "dest": "/public/index.html",
      "headers": { "X-Robots-Tag": "noindex, nofollow" }
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1",
      "headers": { "X-Robots-Tag": "noindex, nofollow" }
    }
  ]
}
